# MediEra Enterprise Digital Healthcare, Clinic Management & Hospital ERP
# Environment Configuration Template

# GEMINI_API_KEY: Required for Gemini AI API calls (clinical insights, report summarization)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# DATABASE & DATA CONFIGURATION
CURRENT_DATABASE="PostgreSQL"
DISABLE_DUMMY_DATA=true
ENABLE_DEMO_DATA=false
ENABLE_DUMMY_DATA=false

# INITIAL SUPER ADMIN BOOTSTRAP (For db:init only)
SUPER_ADMIN_EMAIL="admin@mediera.com"
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION"
SUPER_ADMIN_USER_TYPE="superadmin"

# PostgreSQL Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
PGHOST="localhost"
PGPORT=5432
PGDATABASE="mediera_healthcare_db"
PGUSER="postgres"
PGPASSWORD="YOUR_DATABASE_PASSWORD"
PGSSL=false

# JWT Authentication
JWT_SECRET="YOUR_JWT_SECRET_KEY"
JWT_REFRESH_SECRET="YOUR_JWT_REFRESH_SECRET_KEY"
API_URL="http://localhost:3000/api"
FRONTEND_URL="http://localhost:3000"

# INTEGRATIONS & INFRASTRUCTURE
STORAGE_PROVIDER="s3-compatible-storage"
EMAIL_PROVIDER="smtp-nodemailer-ses"
SMS_PROVIDER="twilio-sms"
WHATSAPP_PROVIDER="meta-whatsapp-business-api"
PAYMENT_PROVIDER="razorpay-stripe-upi"

# NOTIFICATION ENGINE CONFIGURATION
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=true
NOTIFICATION_DEFAULT_CHANNEL=EMAIL
NOTIFICATION_WHATSAPP_PROVIDER=simulation
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# SMTP & EMAIL CONFIGURATION
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="MediEra Healthcare"
SMTP_FROM_EMAIL="noreply@mediera.com"
SMTP_REPLY_TO=

# POS & UPI PAYMENTS CONFIGURATION
ENABLE_POS_PAYMENTS=true
POS_PROVIDER=
POS_TERMINAL_ID=
POS_MERCHANT_ID=
POS_CURRENCY=INR

ENABLE_UPI_PAYMENTS=true
UPI_MERCHANT_NAME="MediEra Healthcare Systems"
UPI_MERCHANT_VPA="mediera@icici"
UPI_PROVIDER="npci-bhim-upi"

# EXTERNAL PAYMENT GATEWAY CONFIGURATION
ENABLE_PAYMENT_GATEWAY=false
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_ENVIRONMENT=sandbox
